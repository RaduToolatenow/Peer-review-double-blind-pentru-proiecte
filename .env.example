# Copy to .env and replace every change_me value.
POSTGRES_USER=peer_review
POSTGRES_PASSWORD=change_me
POSTGRES_DB=peer_review
DATABASE_URL=postgresql://peer_review:change_me@localhost:5432/peer_review
TEST_DATABASE_URL=postgresql://peer_review:change_me@localhost:5432/peer_review_test
SESSION_SECRET=change_me_to_a_long_random_value
PORT=3000
SEED_ADMIN_PASSWORD=change_me
SEED_PROFESSOR_PASSWORD=change_me
SEED_STUDENT_PASSWORD=change_me
# Submission files (D-016): local folder in development, Supabase Storage in production.
FILE_STORE=local
# FILE_STORE=supabase
# SUPABASE_URL=https://<project-id>.supabase.co
# SUPABASE_SERVICE_KEY=change_me   (a secret key, sb_secret_...)
# SUPABASE_BUCKET=submissions
