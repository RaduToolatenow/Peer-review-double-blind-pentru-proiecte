{
  "name": "peer-review-double-blind",
  "private": true,
  "workspaces": ["api", "web"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "db:migrate": "npm run db:migrate -w api",
    "db:seed": "npm run db:seed -w api",
    "typecheck": "npm run typecheck -w api && npm run typecheck -w web",
    "test": "npm test -w api",
    "build": "npm run build -w web && npm run build -w api",
    "start": "npm start -w api"
  }
}
