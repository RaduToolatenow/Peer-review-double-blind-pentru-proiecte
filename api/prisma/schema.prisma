generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  PROFESSOR
  ADMIN
}

enum ReviewStatus {
  ALLOCATED
  SUBMITTED
}

// D-011: an assignment's rubric applies to all its teams, or only to teams given a rubric.
enum RubricScope {
  ALL
  SELECTED
}

enum DisputeStatus {
  OPEN
  UPHELD
  REJECTED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  assignments     Assignment[]
  rubrics         Rubric[]
  teamMemberships TeamMember[]
  reviews         Review[]
  disputesFiled   Dispute[]    @relation("DisputeAuthor")
  disputesDecided Dispute[]    @relation("DisputeDecider")

  @@map("users")
}

// Owned by connect-pg-simple (D-005): column names follow that library.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

model Assignment {
  id                 String      @id @default(uuid()) @db.Uuid
  title              String
  description        String?
  k                  Int
  submissionDeadline DateTime    @map("submission_deadline") @db.Timestamptz
  reviewDeadline     DateTime    @map("review_deadline") @db.Timestamptz
  disputeDeadline    DateTime    @map("dispute_deadline") @db.Timestamptz
  rubricId           String?     @map("rubric_id") @db.Uuid
  rubricAppliesTo    RubricScope @default(ALL) @map("rubric_applies_to")
  createdById        String      @map("created_by_id") @db.Uuid
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz

  createdBy User    @relation(fields: [createdById], references: [id])
  rubric    Rubric? @relation(fields: [rubricId], references: [id], onDelete: Restrict)
  teams     Team[]

  @@map("assignments")
}

// D-011: reusable across assignments. Locked by a trigger at the first saved score;
// archiving and the 1..100 criteria limit are also enforced in the migration SQL.
model Rubric {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lockedAt    DateTime? @map("locked_at") @db.Timestamptz
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz

  createdBy   User              @relation(fields: [createdById], references: [id])
  criteria    RubricCriterion[]
  assignments Assignment[]
  teams       Team[]

  @@map("rubrics")
}

model RubricCriterion {
  id       String @id @default(uuid()) @db.Uuid
  rubricId String @map("rubric_id") @db.Uuid
  title    String
  weight   Int
  position Int

  rubric Rubric           @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  levels CriterionLevel[]
  scores ReviewScore[]

  @@unique([rubricId, position])
  @@map("rubric_criteria")
}

model CriterionLevel {
  id          String @id @default(uuid()) @db.Uuid
  criterionId String @map("criterion_id") @db.Uuid
  score       Int
  descriptor  String

  criterion RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  scores    ReviewScore[]

  @@unique([criterionId, score])
  @@map("criterion_levels")
}

model Team {
  id           String  @id @default(uuid()) @db.Uuid
  assignmentId String  @map("assignment_id") @db.Uuid
  // Set: the team is evaluated on this rubric, which may be the assignment's own (D-011).
  rubricId     String? @map("rubric_id") @db.Uuid

  assignment Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  rubric     Rubric?      @relation(fields: [rubricId], references: [id], onDelete: Restrict)
  members    TeamMember[]
  submission Submission?

  @@unique([id, assignmentId])
  @@map("teams")
}

// assignment_id is repeated so the database can allow one team per student per assignment.
model TeamMember {
  teamId       String @map("team_id") @db.Uuid
  assignmentId String @map("assignment_id") @db.Uuid
  userId       String @map("user_id") @db.Uuid

  team Team @relation(fields: [teamId, assignmentId], references: [id, assignmentId], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@id([teamId, userId])
  @@unique([assignmentId, userId])
  @@map("team_members")
}

model Submission {
  id          String   @id @default(uuid()) @db.Uuid
  teamId      String   @unique @map("team_id") @db.Uuid
  link        String
  fileKey     String?  @map("file_key")
  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz

  team    Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  reviews Review[]

  @@map("submissions")
}

model Review {
  id            String       @id @default(uuid()) @db.Uuid
  submissionId  String       @map("submission_id") @db.Uuid
  reviewerId    String       @map("reviewer_id") @db.Uuid
  isCalibration Boolean      @default(false) @map("is_calibration")
  status        ReviewStatus @default(ALLOCATED)
  submittedAt   DateTime?    @map("submitted_at") @db.Timestamptz

  submission Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User          @relation(fields: [reviewerId], references: [id])
  scores     ReviewScore[]
  disputes   Dispute[]

  @@unique([submissionId, reviewerId])
  @@map("reviews")
}

model ReviewScore {
  reviewId    String @map("review_id") @db.Uuid
  criterionId String @map("criterion_id") @db.Uuid
  levelId     String @map("level_id") @db.Uuid
  feedback    String

  review    Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criterion RubricCriterion @relation(fields: [criterionId], references: [id])
  level     CriterionLevel  @relation(fields: [levelId], references: [id])

  @@id([reviewId, criterionId])
  @@map("review_scores")
}

model Dispute {
  id          String        @id @default(uuid()) @db.Uuid
  reviewId    String        @map("review_id") @db.Uuid
  authorId    String        @map("author_id") @db.Uuid
  argument    String
  status      DisputeStatus @default(OPEN)
  decidedById String?       @map("decided_by_id") @db.Uuid
  decision    String?
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  decidedAt   DateTime?     @map("decided_at") @db.Timestamptz

  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  author    User   @relation("DisputeAuthor", fields: [authorId], references: [id])
  decidedBy User?  @relation("DisputeDecider", fields: [decidedById], references: [id])

  @@map("disputes")
}
