generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  PROFESSOR
  ADMIN
}

enum ReviewStatus {
  ALLOCATED
  SUBMITTED
}

// D-011: an assignment's rubric applies to all teams of its class, or only to chosen ones.
enum RubricScope {
  ALL
  SELECTED
}

enum EmailTokenPurpose {
  VERIFY
  RESET
}

enum DisputeStatus {
  OPEN
  UPHELD
  REJECTED
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  fullName        String    @map("full_name")
  role            Role
  // D-020: null until the emailed link is opened; an unconfirmed account cannot log in.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  assignments     Assignment[]
  rubrics         Rubric[]
  classes         Class[]
  teamMemberships TeamMember[]
  reviews         Review[]
  emailTokens     EmailToken[]
  reviewerOf      AssignmentReviewer[]
  withdrawals     AssignmentWithdrawal[]
  disputesFiled   Dispute[]            @relation("DisputeAuthor")
  disputesDecided Dispute[]            @relation("DisputeDecider")

  @@map("users")
}

// Owned by connect-pg-simple (D-005): column names follow that library.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// One failed login, kept 15 minutes for the attempt limit (D-017). No relation to users,
// so unknown emails are counted the same way.
// D-020: emailed links. Only the SHA-256 of the token is stored; a token works once.
model EmailToken {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  purpose      EmailTokenPurpose
  tokenHash    String            @unique @map("token_hash")
  // A sign-up through an assignment's link makes the account a reviewer once confirmed.
  assignmentId String?           @map("assignment_id") @db.Uuid
  expiresAt    DateTime          @map("expires_at") @db.Timestamptz
  usedAt       DateTime?         @map("used_at") @db.Timestamptz
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@map("email_tokens")
}

// D-020: one row per email sent, only to limit them per address and per IP.
model EmailRequest {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  ip        String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("email_requests")
}

model LoginFailure {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  ip        String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([email, ip, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
  @@map("login_failures")
}

model Assignment {
  id                 String      @id @default(uuid()) @db.Uuid
  title              String
  description        String?
  k                  Int
  submissionDeadline DateTime    @map("submission_deadline") @db.Timestamptz
  reviewDeadline     DateTime    @map("review_deadline") @db.Timestamptz
  disputeDeadline    DateTime    @map("dispute_deadline") @db.Timestamptz
  // D-013: an assignment is a rubric sent to a class.
  rubricId           String      @map("rubric_id") @db.Uuid
  classId            String      @map("class_id") @db.Uuid
  rubricAppliesTo    RubricScope @default(ALL) @map("rubric_applies_to")
  // D-010: the code in the assignment's sign-up link, /inscriere/<code>.
  joinCode           String      @unique @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)")) @map("join_code")
  createdById        String      @map("created_by_id") @db.Uuid
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz
  // D-022: set once, when the job allocates reviewers after the submission deadline.
  allocatedAt        DateTime?   @map("allocated_at") @db.Timestamptz

  createdBy   User                 @relation(fields: [createdById], references: [id])
  rubric      Rubric               @relation(fields: [rubricId], references: [id], onDelete: Restrict)
  class       Class                @relation(fields: [classId], references: [id], onDelete: Restrict)
  chosenTeams AssignmentTeam[]
  submissions Submission[]
  reviewers   AssignmentReviewer[]
  withdrawals AssignmentWithdrawal[]
  emailTokens EmailToken[]

  @@unique([id, classId])
  @@map("assignments")
}

// D-020: people who joined an assignment as reviewers through its link. Members of the
// class's teams are reviewers too, without a row here.
model AssignmentReviewer {
  assignmentId String   @map("assignment_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([assignmentId, userId])
  @@map("assignment_reviewers")
}

// D-022: a student who withdrew from an assignment; final. They are given no more reviews.
model AssignmentWithdrawal {
  assignmentId String   @map("assignment_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([assignmentId, userId])
  @@map("assignment_withdrawals")
}

// D-012: a professor's class; its teams are entered from paper.
model Class {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  createdBy   User         @relation(fields: [createdById], references: [id])
  teams       Team[]
  assignments Assignment[]

  @@map("classes")
}

// The teams an assignment applies to when rubric_applies_to is SELECTED.
// class_id is repeated so the database can require the team and the assignment to share a class.
model AssignmentTeam {
  assignmentId String @map("assignment_id") @db.Uuid
  teamId       String @map("team_id") @db.Uuid
  classId      String @map("class_id") @db.Uuid

  assignment Assignment @relation(fields: [assignmentId, classId], references: [id, classId], onDelete: Cascade)
  team       Team       @relation(fields: [teamId, classId], references: [id, classId], onDelete: Cascade)

  @@id([assignmentId, teamId])
  @@map("assignment_teams")
}

// D-011: reusable across assignments. Locked by a trigger at the first saved score;
// archiving and the 1..100 criteria limit are also enforced in the migration SQL.
model Rubric {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lockedAt    DateTime? @map("locked_at") @db.Timestamptz
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz

  createdBy   User              @relation(fields: [createdById], references: [id])
  criteria    RubricCriterion[]
  assignments Assignment[]

  @@map("rubrics")
}

model RubricCriterion {
  id       String @id @default(uuid()) @db.Uuid
  rubricId String @map("rubric_id") @db.Uuid
  title    String
  weight   Int
  position Int

  rubric Rubric           @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  levels CriterionLevel[]
  scores ReviewScore[]

  @@unique([rubricId, position])
  @@map("rubric_criteria")
}

model CriterionLevel {
  id          String @id @default(uuid()) @db.Uuid
  criterionId String @map("criterion_id") @db.Uuid
  score       Int
  descriptor  String

  criterion RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  scores    ReviewScore[]

  @@unique([criterionId, score])
  // D-023: lets a score's level be checked against its criterion.
  @@unique([id, criterionId])
  @@map("criterion_levels")
}

model Team {
  id          String   @id @default(uuid()) @db.Uuid
  classId     String   @map("class_id") @db.Uuid
  name        String
  // Members as the professor wrote them on paper; never linked to emails (D-012, D-014).
  memberNames String   @default("") @map("member_names")
  // Handed out by the professor; a student enters it once to join (D-012).
  joinCode    String   @unique @map("join_code")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  class           Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  members         TeamMember[]
  assignmentTeams AssignmentTeam[]
  submissions     Submission[]

  @@unique([id, classId])
  @@unique([classId, name])
  @@map("teams")
}

// class_id is repeated so the database can allow one team per student per class.
model TeamMember {
  teamId  String @map("team_id") @db.Uuid
  classId String @map("class_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid

  team Team @relation(fields: [teamId, classId], references: [id, classId], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@id([teamId, userId])
  @@unique([classId, userId])
  @@map("team_members")
}

model Submission {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @map("assignment_id") @db.Uuid
  teamId       String   @map("team_id") @db.Uuid
  link         String
  description  String?
  // D-016: the cleaned file's key in the file store, and whether it is a PDF or a DOCX.
  fileKey      String   @map("file_key")
  fileType     String   @map("file_type")
  submittedAt  DateTime @default(now()) @map("submitted_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  reviews    Review[]

  @@unique([assignmentId, teamId])
  @@map("submissions")
}

model Review {
  id            String       @id @default(uuid()) @db.Uuid
  submissionId  String       @map("submission_id") @db.Uuid
  reviewerId    String       @map("reviewer_id") @db.Uuid
  isCalibration Boolean      @default(false) @map("is_calibration")
  status        ReviewStatus @default(ALLOCATED)
  submittedAt   DateTime?    @map("submitted_at") @db.Timestamptz

  submission Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User          @relation(fields: [reviewerId], references: [id])
  scores     ReviewScore[]
  disputes   Dispute[]

  @@unique([submissionId, reviewerId])
  @@map("reviews")
}

// D-023: written once, when the review is sent; feedback of at least 20 characters, checked in the migration SQL.
model ReviewScore {
  reviewId    String @map("review_id") @db.Uuid
  criterionId String @map("criterion_id") @db.Uuid
  levelId     String @map("level_id") @db.Uuid
  feedback    String

  review    Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criterion RubricCriterion @relation(fields: [criterionId], references: [id])
  // D-023: the level must belong to the scored criterion.
  level     CriterionLevel  @relation(fields: [levelId, criterionId], references: [id, criterionId])

  @@id([reviewId, criterionId])
  @@map("review_scores")
}

model Dispute {
  id          String        @id @default(uuid()) @db.Uuid
  reviewId    String        @map("review_id") @db.Uuid
  authorId    String        @map("author_id") @db.Uuid
  argument    String
  status      DisputeStatus @default(OPEN)
  decidedById String?       @map("decided_by_id") @db.Uuid
  decision    String?
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  decidedAt   DateTime?     @map("decided_at") @db.Timestamptz

  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  author    User   @relation("DisputeAuthor", fields: [authorId], references: [id])
  decidedBy User?  @relation("DisputeDecider", fields: [decidedById], references: [id])

  @@map("disputes")
}
